    "build": "node node_modules/@trhs/wildwood/cli.js build",
    "start": "node node_modules/@trhs/wildwood/cli.js start"
  },
  "treehouse": {
    "platform": "node_modules/@trhs/wildwood/node_modules/@trhs/platform-v2"
  },
  "dependencies": {
