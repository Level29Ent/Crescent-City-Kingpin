    "koota": "0.6.6",
    "oxlint": "1.91.0",
    "react": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "tiny-invariant": "1.3.3",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "vitest": "5.1.0"
  }
