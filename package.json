{
  "private": true,
  "type": "module",
  "scripts": {
    "checks": "node_modules/.bin/tsrs --singleThreaded --incremental --tsBuildInfoFile \"$TMPDIR/tsrs.tsbuildinfo\" --project tsconfig.json && node node_modules/@trhs/wildwood/cli.js lint",
    "test": "node_modules/.bin/vitest run --pool threads --maxWorkers 1 --testTimeout 15000 --passWithNoTests --fsModuleCachePath \"$TMPDIR/vitest\"",
